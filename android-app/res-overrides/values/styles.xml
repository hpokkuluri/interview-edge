<?xml version="1.0" encoding="utf-8"?>
<!-- Copied over Capacitor's default theme by the Android build: navy everywhere, so there is no white flash on launch. -->
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/ie_navy</item>
        <item name="colorPrimaryDark">@color/ie_navy</item>
        <item name="colorAccent">@color/ie_gold</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ie_navy</item>
        <item name="android:statusBarColor">@color/ie_navy</item>
        <item name="android:navigationBarColor">@color/ie_navy</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/ie_navy</item>
        <item name="windowSplashScreenBackground">@color/ie_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
