<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The live interviewer captures audio in the WebView (getUserMedia), which needs this alongside RECORD_AUDIO. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: lets the app open Android's "Update this app?" screen for a newer version of itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application>
        <!-- The AI model runs in its own process (":ai"). If the phone runs out of memory or the model
             crashes, only that process dies — the app keeps running and falls back gracefully. -->
        <service
            android:name="com.arahasoft.edgeai.AiService"
            android:process=":ai"
            android:exported="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
    </application>
</manifest>
